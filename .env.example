# ── Circle ───────────────────────────────────────────────────────────────────
CIRCLE_ADMIN_V2_TOKEN=          # Settings → API → Admin Token
CIRCLE_COMMUNITY_ID=            # Settings → General → Community ID
# CIRCLE_ADMIN_V2_URL=https://app.circle.so/api/admin/v2   # optional override

# ── Resend ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ── Upstash Redis ─────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── JWT (RS256) ───────────────────────────────────────────────────────────────
# Generate with: npm run generate-keys
JWT_PRIVATE_KEY=
# JWT_KEY_ID=circle-auth-1      # optional — change if you rotate keys
# JWT_TTL_SECONDS=604800        # optional — default 7 days

# ── Auth service ──────────────────────────────────────────────────────────────
AUTH_BASE_URL=https://auth.yourdomain.com
# AUTH_COOKIE_NAME=circle_session   # optional
# AUTH_COOKIE_DOMAIN=.yourdomain.com  # optional — for cross-subdomain sharing

# ── Magic link ────────────────────────────────────────────────────────────────
# MAGIC_LINK_TTL_SECONDS=900    # optional — default 15 minutes

# ── Redirect allowlist ────────────────────────────────────────────────────────
# Comma-separated list of allowed redirect origins.
# If blank, any HTTPS URL is permitted (fine for private/self-hosted deployments).
ALLOWED_REDIRECT_ORIGINS=https://app1.yourdomain.com,https://app2.yourdomain.com

# ── Brand (also used in email templates) ──────────────────────────────────────
NEXT_PUBLIC_BRAND_NAME=My Community
NEXT_PUBLIC_BRAND_LOGO_URL=              # optional — full URL to your logo image
NEXT_PUBLIC_BRAND_PRIMARY_COLOR=#2563eb  # optional — button colour
NEXT_PUBLIC_BRAND_FOOTER_TEXT=           # optional — email footer (defaults to "© year BRAND_NAME")
NEXT_PUBLIC_NON_MEMBER_CTA_LABEL=Learn more  # optional — CTA button for non-members

# ── Non-member handling ───────────────────────────────────────────────────────
NON_MEMBER_REDIRECT_URL=https://yourdomain.com
NON_MEMBER_MESSAGE=We couldn't find a membership for that email address.
# NON_MEMBER_CTA_LABEL=Learn more   # optional — server-side override
